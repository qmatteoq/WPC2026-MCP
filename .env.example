TENANT_ID=YOUR_ENTRA_TENANT_GUID
# Explicit accepted audiences: your Entra application client ID and/or the
# Application ID URI generated by the Teams Developer Portal SSO registration.
TOKEN_AUDIENCES=YOUR_API_CLIENT_GUID,YOUR_SSO_APPLICATION_ID_URI
PUBLIC_BASE_URL=https://YOUR_PUBLIC_HTTPS_HOST
REQUIRED_SCOPE=access_as_user
HOST=127.0.0.1
PORT=3001
DATA_FILE=data/claims.json
ACCESS_FILE=config/access.json
